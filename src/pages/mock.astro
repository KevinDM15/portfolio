---
// Design mock v2: angular tech language. Static, CSS only, not linked from the site.
const title = 'Maqueta · Kevin Díaz';
---
<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
	<style>
		@font-face{font-family:'DM Mono';src:url('/fonts/dm-mono-latin-400-normal.woff2') format('woff2');font-weight:400}
		:root{--ink:#070A14;--ink2:#0C1124;--paper:#F2F4FF;--mute:#9AA0C2;--lime:#B8FF3A;--cyan:#2BE4FF;--coral:#FF5A2B;--violet:#8B5CFF;
			--cut:26px;--oct:polygon(var(--cut) 0,calc(100% - var(--cut)) 0,100% var(--cut),100% calc(100% - var(--cut)),calc(100% - var(--cut)) 100%,var(--cut) 100%,0 calc(100% - var(--cut)),0 var(--cut))}
		*{box-sizing:border-box}
		html{overflow-x:clip}
		html,body{margin:0;background:var(--ink);color:var(--paper);font:400 17px/1.6 'IBM Plex Sans',system-ui,sans-serif}
		body{position:relative;min-height:100vh;perspective:1400px}
		h1,h2,.mark,.btn,.plate-tag{font-family:'Chakra Petch',sans-serif}

		/* depth: fog, a perspective floor that recedes, and the far map */
		.fog{position:fixed;inset:0;z-index:0;pointer-events:none;background:
			radial-gradient(60% 50% at 15% 12%,rgba(139,92,255,.30),transparent 60%),
			radial-gradient(45% 40% at 88% 28%,rgba(43,228,255,.16),transparent 60%),
			radial-gradient(50% 40% at 60% 100%,rgba(255,90,43,.16),transparent 60%)}
		.floor{position:fixed;left:50%;bottom:-12vh;z-index:0;width:260vw;height:120vh;transform:translateX(-50%) rotateX(72deg);transform-origin:50% 100%;pointer-events:none;
			background:linear-gradient(90deg,rgba(43,228,255,.22) 1px,transparent 1px) 0 0/80px 80px,linear-gradient(0deg,rgba(43,228,255,.22) 1px,transparent 1px) 0 0/80px 80px;
			-webkit-mask-image:radial-gradient(60% 90% at 50% 100%,#000 20%,transparent 75%);mask-image:radial-gradient(60% 90% at 50% 100%,#000 20%,transparent 75%)}
		.map{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.5}
		.map svg{width:100%;height:100%}

		/* the cable with its glow */
		.cable{position:absolute;left:0;top:0;width:100%;height:2200px;z-index:1;pointer-events:none;overflow:visible}
		.cable path{fill:none;stroke-linecap:round;stroke-linejoin:round}
		.cable .glow{stroke:var(--lime);stroke-width:12;opacity:.4;filter:blur(9px)}
		.cable .core{stroke:var(--lime);stroke-width:2}
		.cable .dim{stroke:var(--mute);stroke-width:1.2;opacity:.4;stroke-dasharray:3 9}
		.cable .packet{fill:var(--coral);filter:drop-shadow(0 0 12px var(--coral))}
		.cable .node{fill:var(--ink);stroke:var(--lime);stroke-width:2;filter:drop-shadow(0 0 8px var(--lime))}
		.cable .node.off{stroke:var(--mute);filter:none;opacity:.6}

		/* top: the mark and the route */
		.top{position:fixed;left:0;right:0;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:20px clamp(20px,4vw,60px);pointer-events:none}
		.top>*{pointer-events:auto}
		.mark{font-weight:700;font-size:19px;letter-spacing:.02em;color:var(--paper);text-decoration:none;white-space:nowrap}
		.route{display:flex;align-items:center;gap:14px;font-size:14px;color:var(--mute)}
		.route svg{width:210px;height:30px;overflow:visible}
		.route .p{fill:none;stroke:rgba(154,160,194,.45);stroke-width:1.5}
		.route .h{fill:var(--ink);stroke:var(--mute);stroke-width:1.5}
		.route .h.on{fill:var(--lime);stroke:var(--lime);filter:drop-shadow(0 0 8px var(--lime))}
		.route b{font-weight:500;color:var(--paper)}

		/* plates: chamfered panels standing in space */
		.plate{position:relative;clip-path:var(--oct);background:linear-gradient(160deg,rgba(26,32,62,.82),rgba(9,12,26,.6));-webkit-backdrop-filter:blur(22px);backdrop-filter:blur(22px)}
		.plate::before{content:'';position:absolute;inset:0;clip-path:var(--oct);padding:1px;background:linear-gradient(160deg,rgba(43,228,255,.7),rgba(43,228,255,.08) 40%,rgba(184,255,58,.5));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
		.plate-wrap{filter:drop-shadow(0 40px 60px rgba(0,0,0,.7)) drop-shadow(0 0 40px rgba(43,228,255,.18))}

		main{position:relative;z-index:2}
		.hero{position:relative;min-height:100vh;max-width:1500px;margin:0 auto;padding:130px clamp(20px,4vw,60px) 80px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,520px);align-items:center;gap:clamp(24px,5vw,90px)}
		.hero h1{margin:0;font-weight:700;font-size:clamp(38px,4.6vw,70px);line-height:1.02;letter-spacing:-.01em;text-wrap:balance}
		.hero h1 b{display:block;font-weight:500;color:var(--cyan)}
		.hero p{max-width:44ch;margin:26px 0 34px;font-size:clamp(17px,1.25vw,20px);color:var(--mute)}
		.btn{display:inline-block;padding:16px 34px;clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);background:var(--lime);color:var(--ink);font-weight:700;font-size:17px;letter-spacing:.04em;text-decoration:none;transition:transform .3s}
		.btn:hover{transform:translateY(-2px)}
		.btn-wrap{display:inline-block;filter:drop-shadow(0 0 24px rgba(184,255,58,.45))}
		.where{display:flex;align-items:center;gap:12px;margin-top:40px;color:var(--mute);font-size:15px}
		.where i{width:9px;height:9px;background:var(--lime);box-shadow:0 0 12px var(--lime);transform:rotate(45deg);animation:pulse 2.4s ease-in-out infinite}
		@keyframes pulse{50%{transform:rotate(45deg) scale(.55);opacity:.6}}

		/* the portrait plate: the central node, standing at an angle in space */
		.portrait-wrap{justify-self:end;width:100%;transform:rotateY(-10deg) rotateX(2deg);transform-style:preserve-3d}
		.portrait{aspect-ratio:.86;overflow:hidden;isolation:isolate;--cut:38px}
		.portrait img{position:absolute;inset:-4% -2% 0;width:104%;height:104%;object-fit:cover;object-position:50% 10%;filter:grayscale(1) contrast(1.35) brightness(1.05)}
		.portrait .dots{position:absolute;inset:0;z-index:1;background:radial-gradient(circle,var(--ink) 1.1px,transparent 1.45px) 0 0/6px 6px;mix-blend-mode:multiply;opacity:.92}
		.portrait .tint{position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,transparent 50%,rgba(139,92,255,.55)),linear-gradient(90deg,rgba(43,228,255,.12),transparent 40%)}
		.plate-tag{position:absolute;z-index:3;left:30px;bottom:26px;font-size:13px;letter-spacing:.08em;color:var(--lime);display:flex;align-items:center;gap:10px}
		.plate-tag i{width:8px;height:8px;background:var(--lime);transform:rotate(45deg);box-shadow:0 0 10px var(--lime)}
		.scan{position:absolute;z-index:3;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,transparent,rgba(43,228,255,.9),transparent);animation:scan 5s linear infinite;opacity:.7}
		@keyframes scan{to{transform:translateY(600px)}}

		/* sobre mí: a wide plate and the agent orbit */
		.about{position:relative;max-width:1500px;margin:0 auto;padding:140px clamp(20px,4vw,60px) 220px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(30px,5vw,80px);align-items:center}
		.about .plate-wrap{transform:rotateY(5deg)}
		.about .plate{padding:clamp(36px,5vw,76px) clamp(30px,5vw,72px)}
		.about h2{margin:0 0 26px;font-weight:700;font-size:clamp(28px,3.4vw,52px);line-height:1.05;letter-spacing:-.01em;text-wrap:balance}
		.about h2 b{font-weight:500;color:var(--lime)}
		.about p{margin:0 0 16px;max-width:52ch;color:var(--mute);font-size:17px}
		.orbit{position:sticky;top:120px;justify-self:center;width:min(100%,440px);aspect-ratio:1}
		.orbit svg{width:100%;height:100%;overflow:visible}
		.orbit .o{fill:none;stroke:rgba(43,228,255,.4);stroke-width:1.2;stroke-dasharray:4 10}
		.orbit .i{fill:none;stroke:rgba(242,244,255,.35);stroke-width:1.2}
		.orbit .me{fill:var(--lime);filter:drop-shadow(0 0 26px rgba(184,255,58,.8))}
		.orbit .me-t{font:700 36px 'Chakra Petch',sans-serif;fill:var(--ink);text-anchor:middle}
		.orbit .st{fill:var(--cyan);filter:drop-shadow(0 0 10px var(--cyan))}
		.orbit .lb{font:500 16px 'Chakra Petch',sans-serif;fill:var(--paper);text-anchor:middle;letter-spacing:.06em}
		.orbit .cap{font:400 14px 'IBM Plex Sans',sans-serif;fill:var(--mute);text-anchor:middle}

		@media (max-width:900px){
			.hero{grid-template-columns:minmax(0,1fr);padding-top:100px}
			.portrait-wrap{justify-self:start;width:min(82vw,420px);transform:none}
			.about{grid-template-columns:minmax(0,1fr);padding-top:40px}
			.about .plate-wrap{transform:none}
			.orbit{position:static;width:min(100%,340px)}
			.route span{display:none}
			.floor{bottom:-30vh}
		}
	</style>
</head>
<body>
	<div class="fog" aria-hidden="true"></div>
	<div class="floor" aria-hidden="true"></div>
	<div class="map" aria-hidden="true">
		<svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
			<g stroke="#8B5CFF" stroke-opacity=".35" fill="none" stroke-width="1">
				<path d="M60 120L180 210L300 160L420 300L520 240M180 210L250 420L420 300M900 80L1040 180L1180 120L1300 260L1400 220M1040 180L1100 380L1300 260M120 700L260 640L380 760L560 700M980 640L1120 720L1260 660L1380 780"/>
			</g>
			<g fill="#2BE4FF" fill-opacity=".8">
				<rect x="177" y="207" width="6" height="6" transform="rotate(45 180 210)"/><rect x="417" y="297" width="7" height="7" transform="rotate(45 420 300)"/><rect x="1037" y="177" width="7" height="7" transform="rotate(45 1040 180)"/><rect x="1297" y="257" width="6" height="6" transform="rotate(45 1300 260)"/><rect x="377" y="757" width="7" height="7" transform="rotate(45 380 760)"/><rect x="1117" y="717" width="7" height="7" transform="rotate(45 1120 720)"/><rect x="257" y="637" width="6" height="6" transform="rotate(45 260 640)"/><rect x="1257" y="657" width="6" height="6" transform="rotate(45 1260 660)"/>
			</g>
		</svg>
	</div>

	<svg class="cable" viewBox="0 0 1440 2200" preserveAspectRatio="none" aria-hidden="true">
		<path class="glow" d="M1120 820L1120 900L560 1000L560 1120"/>
		<path class="core" d="M1120 820L1120 900L560 1000L560 1120"/>
		<path class="dim" d="M560 1120L560 1500L1100 1600L1100 1900"/>
		<circle class="node" cx="1120" cy="820" r="6"/>
		<circle class="node" cx="560" cy="1120" r="6"/>
		<circle class="node off" cx="1100" cy="1900" r="6"/>
		<circle class="packet" cx="840" cy="950" r="6"/>
	</svg>

	<header class="top">
		<a class="mark" href="#">KEVIN DÍAZ</a>
		<div class="route" aria-label="Dónde estás en el recorrido">
			<svg viewBox="0 0 210 30" aria-hidden="true">
				<path class="p" d="M8 22L50 22L80 8L120 8L150 22L200 22"/>
				<rect class="h on" x="4" y="18" width="8" height="8" transform="rotate(45 8 22)"/><rect class="h" x="46" y="18" width="8" height="8" transform="rotate(45 50 22)"/><rect class="h" x="96" y="4" width="8" height="8" transform="rotate(45 100 8)"/><rect class="h" x="146" y="18" width="8" height="8" transform="rotate(45 150 22)"/><rect class="h" x="196" y="18" width="8" height="8" transform="rotate(45 200 22)"/>
			</svg>
			<span>estás en <b>inicio</b></span>
		</div>
	</header>

	<main>
		<section class="hero">
			<div>
				<h1>Construyo software que el equipo puede mantener.<b>Hoy lo hago con agentes de IA.</b></h1>
				<p>Desarrollador full-stack en Barranquilla. APIs, apps web y móviles, con una arquitectura que aguanta el paso del tiempo.</p>
				<span class="btn-wrap"><a class="btn" href="#contacto">Escríbeme</a></span>
				<div class="avail"><i></i>Disponible para nuevos proyectos</div>
			</div>
			<div class="plate-wrap portrait-wrap">
				<div class="plate portrait">
					<img src="/img/retrato.jpg" alt="Retrato de Kevin Díaz" />
					<div class="dots"></div><div class="tint"></div><div class="scan"></div>
					<div class="plate-tag"><i></i>kevin.local</div>
				</div>
			</div>
		</section>

		<section class="about" id="sobre">
			<div class="plate-wrap">
				<div class="plate">
					<h2>Llevo más de seis años construyendo productos digitales. <b>Hoy decido el rumbo y los agentes ejecutan.</b></h2>
					<p>Casi nada lo resuelvo solo. Trabajo con agentes de IA como con un equipo: cada uno recibe una tarea pequeña, un alcance claro y un criterio para saber cuándo terminó.</p>
					<p>Todo empieza por entender el problema y escribir qué se espera, con criterios que se puedan comprobar. Esa especificación es la fuente de verdad: los agentes la leen y yo la defiendo.</p>
					<p>Desde 2018, cinco empresas y clientes, del backend al frontend. Koombea, Wawandco, Rocket Code y ahora por mi cuenta.</p>
				</div>
			</div>
			<div class="orbit" aria-label="Cómo trabajo: yo al centro, los agentes alrededor">
				<svg viewBox="0 0 460 460">
					<circle class="o" cx="230" cy="230" r="200"/>
					<circle class="i" cx="230" cy="230" r="120"/>
					<circle class="me" cx="230" cy="230" r="64"/>
					<text class="me-t" x="230" y="243">YO</text>
					<rect class="st" x="224" y="24" width="12" height="12" transform="rotate(45 230 30)"/><rect class="st" x="424" y="224" width="12" height="12" transform="rotate(45 430 230)"/><rect class="st" x="224" y="424" width="12" height="12" transform="rotate(45 230 430)"/><rect class="st" x="24" y="224" width="12" height="12" transform="rotate(45 30 230)"/>
					<text class="lb" x="230" y="6">ENTENDER</text>
					<text class="lb" x="436" y="262">DELEGAR</text>
					<text class="lb" x="230" y="466">VERIFICAR</text>
					<text class="lb" x="24" y="262">ENTREGAR</text>
					<text class="cap" x="230" y="146">agentes</text>
				</svg>
			</div>
		</section>
	</main>
</body>
</html>
