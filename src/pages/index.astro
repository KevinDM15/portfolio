---
import Portfolio from '../components/portfolio/Portfolio.astro';

const title = 'Kevin Díaz · Portafolio';
const description = 'Desarrollador full-stack en Barranquilla, Colombia. APIs con arquitectura limpia e interfaces mantenibles.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/svg/favicon.svg" />
		<meta name="theme-color" content="#EFEEE9" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
	</head>
	<body>
		<Portfolio />
	</body>
</html>
