---
/*
 * The landing, composed: the map behind everything, the bar, the sections in reading order, the light block that
 * closes the page, the toast and the chat. Each section owns its markup; data lives in data.ts; behaviours in behaviours/.
 */
import './styles/tokens.css';
import './styles/base.css';
import './styles/header.css';
import './styles/plates.css';
import './styles/hero.css';
import './styles/band.css';
import './styles/about.css';
import './styles/projects.css';
import './styles/experience.css';
import './styles/paper.css';
import './styles/contact.css';
import './styles/footer.css';
import './styles/toast.css';
import './styles/responsive.css';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import TechBand from './sections/TechBand.astro';
import About from './sections/About.astro';
import Projects from './sections/Projects.astro';
import Experience from './sections/Experience.astro';
import Waves from './sections/Waves.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';
import { ChatBot } from '../islands/ChatBot';
---

<div data-kd data-t="dark">
	<div class="kd-fog" aria-hidden="true"></div>
	<canvas data-k="net" class="kd-net" aria-hidden="true"></canvas>

	<Header />

	<main id="top">
		<Hero />
		<TechBand />
		<About />
		<Projects />
		<Experience />
		<div class="kd-paper">
			<Waves />
			<Contact />
			<Footer />
		</div>
	</main>

	<div data-k="toast" class="kd-toast" role="status" aria-live="polite">Correo copiado</div>
	<ChatBot client:load />
</div>

<script>
	import { initPortfolio } from './behaviours';
	initPortfolio();
</script>
