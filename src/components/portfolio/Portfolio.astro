---
import './portfolio.css';
import { ChatBot } from '../islands/ChatBot';

// Set to true when the first real project is published: restores the project list and stage below.
const showProjects = false;
---

<div data-kd data-t="light" style="--bg:#EFEEE9; --surface:#E4E3DC; --fg:#0F0F11; --muted:#5D5D66; --line:rgba(15,15,17,.12); --line-strong:rgba(15,15,17,.32); --accent:#D4470E; --c1:#D4470E; --c2:#B97A00; --c3:#2F9E68; --c2-on:#FFFFFF; --c3-on:#FFFFFF; --grain:.12; position:relative; background:var(--bg); color:var(--fg); font:400 16px/1.6 'DM Mono',ui-monospace,Menlo,monospace; letter-spacing:-.01em; -webkit-font-smoothing:antialiased">
<script is:inline>
	// Paint a saved dark theme before first render; mirrors the dark palette in portfolio.ts
	(function () {
		try {
			if (localStorage.getItem('kd-theme') !== 'dark') return;
			var r = document.currentScript.parentElement, v = {"--bg": "#0F0F11", "--surface": "#18181B", "--fg": "#EFEEE9", "--muted": "#9C9CA4", "--line": "rgba(239,238,233,.11)", "--line-strong": "rgba(239,238,233,.28)", "--accent": "#F2602B", "--c1": "#F2602B", "--c2": "#F2B134", "--c3": "#5DD39E", "--c2-on": "#0F0F11", "--c3-on": "#0F0F11", "--grain": ".07"};
			for (var k in v) r.style.setProperty(k, v[k]);
			r.setAttribute('data-t', 'dark');
			document.documentElement.style.backgroundColor = v['--bg'];
			document.documentElement.style.colorScheme = 'dark';
			document.body.style.backgroundColor = v['--bg'];
			var m = document.querySelector('meta[name="theme-color"]');
			if (m) m.content = v['--bg'];
		} catch (e) {}
	})();
</script>
<div data-k="wrap" style="container-type:inline-size; position:relative; overflow-x:clip; --g:clamp(16px,4cqw,56px)">

<div data-k="cols" aria-hidden="true" style="position:absolute; inset:0; pointer-events:none; z-index:0">

</div>
<div aria-hidden="true" style="position:absolute; inset:0; pointer-events:none; z-index:60; opacity:var(--grain); mix-blend-mode:overlay; background-image:url(svg/textura-grano.svg)"></div>



<main id="top" style="position:relative; z-index:1">

<section data-screen-label="01 Hero" style="position:relative; box-sizing:border-box; max-width:1480px; margin:0 auto; padding:calc(24px + clamp(28px,6cqw,72px)) var(--g) 28px; min-height:var(--L-heroMin); display:flex; flex-direction:column; justify-content:space-between; gap:32px">
<div data-k="orb" style="position:var(--L-orbPos); right:var(--L-orbRight); z-index:0; aspect-ratio:1; width:var(--L-orbW); top:var(--L-orbTop); bottom:var(--L-orbBottom); margin:var(--L-orbMargin); order:1">
  <canvas data-k="cv" role="img" aria-label="Retrato de Kevin hecho de puntos que se apartan del cursor" style="width:100%; height:100%; display:block"></canvas>
  
    <div data-note="1" aria-hidden="true" style="position:absolute; z-index:3; left:var(--L-pn-l); right:var(--L-pn-r); top:var(--L-pn-t); bottom:var(--L-pn-b); display:flex; flex-direction:column; gap:2px; font-family:'Reenie Beanie',cursive; color:var(--accent); font-size:clamp(24px,2.8cqw,38px); line-height:.9; transform:rotate(-5deg); pointer-events:none">
      <svg viewBox="0 0 110 70" style="width:clamp(56px,8cqw,104px); overflow:visible; fill:none; stroke:var(--accent); stroke-width:3; stroke-linecap:round; stroke-linejoin:round"><path data-ink="1" pathLength="1" d="M8 64C20 30 56 10 98 8M84 -2L99 8L86 22" style="stroke-dasharray:1"></path></svg>
      <span data-t="1">este soy yo,<br>sin filtro</span>
    </div>
  
</div>

<div style="position:relative; z-index:1; display:flex; justify-content:space-between; gap:8px 16px; flex-wrap:wrap; font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted)">
  <span>Edición 2026</span><span>Barranquilla, Colombia</span>
</div>

<div style="position:relative; order:2; margin-top:clamp(72px,6cqw,88px)">
  
    <div data-note="1" aria-hidden="true" style="position:absolute; z-index:3; left:clamp(0px,1cqw,16px); top:0; transform:translateY(-108%) rotate(-3deg); display:flex; flex-direction:column; font-family:'Reenie Beanie',cursive; color:var(--accent); font-size:clamp(24px,2.8cqw,38px); line-height:.9; pointer-events:none">
      <span data-t="1">¿qué más? un gusto.</span>
      <svg viewBox="0 0 124 14" style="width:120px; margin-top:2px; overflow:visible; fill:none; stroke:var(--accent); stroke-width:3; stroke-linecap:round"><path data-ink="1" pathLength="1" d="M2 8Q20 0 40 8T80 8T120 6" style="stroke-dasharray:1"></path></svg>
    </div>
  
  <h1 aria-label="Kevin Díaz" style="position:relative; z-index:1; margin:0; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; line-height:.8; letter-spacing:-.025em; font-size:clamp(88px,21cqw,340px)">
    <span style="display:block; overflow:hidden; padding:.06em 0 .02em"><span data-ln="1" style="display:block">Kevin</span></span>
    <span style="display:block; overflow:hidden; padding:.06em 0 .02em clamp(24px,9cqw,170px)"><span data-ln="1" style="display:block">Díaz<em style="font-family:'Instrument Serif',Georgia,serif; font-weight:400; text-transform:none; letter-spacing:-.04em; color:var(--accent)">.</em></span></span>
  </h1>
  <div style="position:relative; z-index:1; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:24px; margin-top:clamp(24px,4cqw,48px)">
    <p style="margin:0; flex:1 1 300px; max-width:40ch; font-size:clamp(15px,1.6cqw,18px); color:var(--fg); text-wrap:pretty">Desarrollador de software <span style="font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:1.2em; color:var(--accent)">full-stack</span>. Construyo APIs, apps web y móviles con IA integrada, sobre una arquitectura que el equipo puede mantener.</p>
    <a href="#contacto" data-glow style="position:relative; isolation:isolate; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:space-between; gap:22px; padding:10px 10px 10px 24px; border-radius:999px; text-decoration:none; color:var(--fg); overflow:hidden; flex:var(--L-availFlex); background:linear-gradient(115deg, color-mix(in srgb, var(--fg) 12%, transparent), color-mix(in srgb, var(--fg) 3%, transparent) 45%, color-mix(in srgb, var(--fg) 8%, transparent)); -webkit-backdrop-filter:blur(14px) saturate(1.8); backdrop-filter:blur(14px) saturate(1.8); border:1px solid color-mix(in srgb, var(--fg) 16%, transparent); box-shadow:inset 0 1.5px 0 rgba(255,255,255,.34), inset 0 -1.5px 0 rgba(255,255,255,.06), 0 14px 32px -12px rgba(0,0,0,.5); transition:transform .5s cubic-bezier(.34,1.5,.5,1), border-color .3s" class="hv2">
      <span aria-hidden="true" style="position:absolute; inset:0; border-radius:inherit; z-index:-1; pointer-events:none; background:radial-gradient(160px 90px at var(--mx,20%) var(--my,0%), rgba(255,255,255,.28), transparent 70%); mix-blend-mode:overlay"></span>
      <span style="display:flex; flex-direction:column; gap:4px">
        <small style="font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted)">Estado · <b style="color:var(--fg); font-weight:500; font-variant-numeric:tabular-nums"><span data-time>--:--</span></b> en Barranquilla</small>
        <strong style="font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(21px,2.1cqw,28px); line-height:.95">Disponible para <em style="font-family:'Instrument Serif',Georgia,serif; font-weight:400; text-transform:none; color:var(--accent); letter-spacing:-.02em; font-size:1.15em">nuevos proyectos</em></strong>
      </span>
      <span aria-hidden="true" style="width:46px; height:46px; border-radius:50%; display:grid; place-items:center; flex:none; background:var(--accent); color:var(--on-accent,#fff); box-shadow:inset 0 1px 0 rgba(255,255,255,.4), 0 8px 18px -6px var(--accent)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px; height:18px; transform:rotate(-45deg)"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
    </a>
  </div>
</div>
</section>

<div aria-label="Tecnologías" data-marq-host style="position:relative; z-index:1; overflow:hidden; padding:14px 0; border-top:1px solid var(--line-strong); border-bottom:1px solid var(--line-strong); background:var(--bg)">
<div data-k="marq" style="display:flex; width:max-content; will-change:transform">
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Next.js<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">React<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">React Native<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">TypeScript<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">NestJS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Go<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">PostgreSQL<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">AWS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">GCP<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">TailwindCSS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Next.js<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">React<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">React Native<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">TypeScript<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">NestJS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Go<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">PostgreSQL<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">AWS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">GCP<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
<span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">TailwindCSS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
</div>
</div>

<section id="sobre" data-screen-label="02 Sobre mí" style="box-sizing:border-box; max-width:1480px; margin:0 auto; padding:clamp(96px,16cqw,220px) var(--g)">
<div style="display:grid; gap:12px clamp(24px,4cqw,64px); align-items:start; grid-template-columns:var(--L-leadCols)">
  <span style="font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); padding-top:.6em">( Sobre mí )</span>
  <div style="min-width:0"><p data-k="st" style="margin:0; max-width:20ch; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:600; text-transform:uppercase; font-size:clamp(34px,5.4cqw,88px); line-height:.98; letter-spacing:-.015em; color:var(--fg)">Llevo más de seis años construyendo productos digitales. Hoy los resuelvo con <em style="font-family:'Instrument Serif',Georgia,serif; font-weight:400; text-transform:none; letter-spacing:-.03em">agentes de IA</em>, y yo decido el rumbo.</p>
<div style="display:grid; gap:16px; margin-top:clamp(28px,4cqw,56px)"><p data-rv style="margin:0; max-width:56ch; color:var(--muted); font-size:14px; text-wrap:pretty">Hoy casi nada lo resuelvo solo. Trabajo con agentes de IA como con un equipo: cada uno recibe una tarea pequeña, un alcance claro y un criterio para saber cuándo terminó.</p><p data-rv style="margin:0; max-width:56ch; color:var(--muted); font-size:14px; text-wrap:pretty">Todo empieza por entender el problema y escribir qué se espera, con criterios que se puedan comprobar. Esa especificación es la fuente de verdad: los agentes la leen y yo la defiendo.</p><p data-rv style="margin:0; max-width:56ch; color:var(--muted); font-size:14px; text-wrap:pretty">Después divido el trabajo en piezas independientes y las reparto. Nada se da por bueno hasta que se prueba, y una revisión aparte contrasta el resultado con lo que se pidió.</p><p data-rv style="margin:0; max-width:56ch; color:var(--muted); font-size:14px; text-wrap:pretty">Las decisiones de fondo son mías, y las entregas son pequeñas y fáciles de revisar, cada una con su porqué. Lo que se aprende queda guardado para la próxima vez. Lo oriento a código que otra persona pueda mantener sin sufrir.</p></div></div>
  <figure data-par style="position:relative; margin:0; width:100%; max-width:520px; grid-column:var(--L-figCol); margin-top:var(--L-figMt)">
    
      <div data-note="1" aria-hidden="true" style="position:absolute; z-index:3; right:6px; top:-40px; display:flex; align-items:flex-end; gap:4px; font-family:'Reenie Beanie',cursive; color:var(--accent); font-size:clamp(24px,2.6cqw,34px); line-height:.9; transform:rotate(-4deg); pointer-events:none">
        <span data-t="1">así trabajo</span>
        <svg viewBox="0 0 60 40" style="width:44px; overflow:visible; fill:none; stroke:var(--accent); stroke-width:3; stroke-linecap:round; stroke-linejoin:round"><path data-ink="1" pathLength="1" d="M4 6C28 4 44 14 50 34M40 28L51 36L55 23" style="stroke-dasharray:1"></path></svg>
      </div>
    
    <div style="position:relative; aspect-ratio:1 / 1; background:var(--surface); border:1px solid var(--line-strong); overflow:hidden">
      <span style="position:absolute; left:14px; top:12px; right:14px; display:flex; justify-content:space-between; font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted)"><span>flujo.agentes</span><span style="color:var(--accent)">humano al mando</span></span>
      <svg viewBox="-40 -10 480 420" fill="none" stroke="currentColor" aria-label="Diagrama del flujo de trabajo con agentes" role="img" style="position:absolute; left:4%; top:9%; width:92%; height:88%; color:var(--fg)">
      <circle cx="200" cy="200" r="160" stroke-dasharray="4 6" stroke-opacity=".45"></circle>
      <circle cx="200" cy="200" r="100" stroke-width="1.2"></circle>
      <circle cx="200" cy="200" r="56" stroke="none" style="fill:var(--accent)"></circle>
      <path d="M200 144V40M256 200H360M200 256V360M144 200H40" stroke-opacity=".55"></path>
      <g stroke="none" style="fill:var(--fg)"><rect x="193" y="33" width="14" height="14"></rect><rect x="353" y="193" width="14" height="14"></rect><rect x="193" y="353" width="14" height="14"></rect><rect x="33" y="193" width="14" height="14"></rect></g>
