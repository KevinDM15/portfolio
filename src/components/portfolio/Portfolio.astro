---
import './portfolio.css';
import { ChatBot } from '../islands/ChatBot';
import { execSync } from 'node:child_process';

// build facts for the HUD and the footer: the deployed commit (Vercel exposes it, git answers locally) and the build date
const sha = (process.env.VERCEL_GIT_COMMIT_SHA ?? (() => { try { return execSync('git rev-parse HEAD').toString().trim(); } catch { return ''; } })()).slice(0, 7);
const built = (() => { const p = new Intl.DateTimeFormat('es-CO', { timeZone: 'America/Bogota', day: 'numeric', month: 'short', year: 'numeric' }).formatToParts(new Date()); const g = (t: string) => p.find((x) => x.type === t)?.value.replace('.', '') ?? ''; return `${g('day')} ${g('month')} ${g('year')}`; })();
const repo = 'https://github.com/KevinDM15/portfolio';
// where Kevin has worked, with the initials shown on the tiles
const companies = {
	cuc: { name: 'Universidad de la Costa', short: 'CUC', url: 'https://www.cuc.edu.co' },
	elsol: { name: 'El Sol Neighborhood Educational Center', short: 'El Sol', url: 'https://elsolnec.org' },
	rocket: { name: 'The Rocket Code', short: 'RC', url: 'https://therocketcode.com' },
	wawandco: { name: 'Wawandco', short: 'W', url: 'https://wawand.co' },
	koombea: { name: 'Koombea', short: 'K', url: 'https://www.koombea.com' },
};
// what is being built right now, while the first case study is on its way
const building = [
	{ name: 'Este portafolio', text: 'La landing como mapa de red con PixiJS sobre Astro, y un asistente que responde con el CV como contexto.', url: repo, meta: 'TypeScript · Astro' },
];
// the stack as network modules: name, where it lives in my work, a short interface-like id and its mark
const tech = [
	{ name: 'React', kind: 'frontend', id: 'ui0', icon: 'react' }, { name: 'Next.js', kind: 'frontend', id: 'ui1', icon: 'nextdotjs' }, { name: 'React Native', kind: 'móvil', id: 'mb0', icon: 'react' }, { name: 'TypeScript', kind: 'lenguaje', id: 'ts0', icon: 'typescript' },
	{ name: 'NestJS', kind: 'backend', id: 'api0', icon: 'nestjs' }, { name: 'Go', kind: 'backend', id: 'api1', icon: 'go' }, { name: 'Python', kind: 'backend', id: 'api2', icon: 'python' }, { name: 'PostgreSQL', kind: 'datos', id: 'db0', icon: 'postgresql' },
	{ name: 'AWS', kind: 'cloud', id: 'cl0', icon: 'amazonwebservices' }, { name: 'GCP', kind: 'cloud', id: 'cl1', icon: 'googlecloud' }, { name: 'LLMs', kind: 'IA', id: 'ai0', icon: 'llm' }, { name: 'Arquitectura hexagonal', kind: 'diseño', id: 'arq', icon: 'hexagonal' },
];
const jobs = [
	{ when: 'Jun 2026 — hoy', span: '4 meses y contando', name: 'Universidad de la Costa', url: companies.cuc.url, role: 'Desarrollador full-stack · Freelance', text: 'Desarrollo aplicaciones web con Vite y React y diseño arquitecturas y planes técnicos para nuevas funcionalidades. Migro de forma progresiva módulos legacy (PHP, JavaScript y jQuery) hacia una arquitectura moderna, con React en el frontend y Python serverless en el backend.', tags: ['React', 'Vite', 'Python', 'Serverless'] },
	{ when: 'Ene 2026 — hoy', span: '9 meses y contando', name: 'El Sol Neighborhood Educational Center', url: companies.elsol.url, role: 'Desarrollador full-stack · Freelance', text: 'Desarrollo aplicaciones web y móviles con Next.js, React y React Native, con interfaces multiplataforma que priorizan rendimiento, usabilidad y consistencia visual. Diseño arquitecturas y planes técnicos, y trabajo en equipos ágiles con Scrum.', tags: ['Next.js', 'React', 'React Native'] },
	{ when: 'Oct 2023 — Jul 2026', span: '2 años, 9 meses', name: 'The Rocket Code', url: companies.rocket.url, role: 'Desarrollador full-stack · Freelance', text: 'Optimicé aplicaciones del lado del cliente para escalar y responder más rápido. Creé APIs con NestJS, PostgreSQL y AWS bajo arquitectura hexagonal, integré modelos de lenguaje (LLMs) por API para automatizar procesos y construí componentes reutilizables con React, MaterialUI, Redux y Next.js.', tags: ['Next.js', 'React', 'NestJS', 'PostgreSQL', 'AWS', 'LLMs'] },
	{ when: 'Ago 2020 — Abr 2023', span: '2 años, 8 meses', name: 'Wawandco', url: companies.wawandco.url, role: 'Desarrollador full-stack', text: 'Mejoré código nativo en Go aplicando SOLID, Clean Code y MVC. Implementé servicios backend y funciones serverless en GCP, reduje la deuda técnica y migré librerías a versiones actuales.', tags: ['Go', 'GCP', 'Cloud Functions', 'Firestore'] },
	{ when: 'Ago — Dic 2018', span: '5 meses', name: 'Koombea', url: companies.koombea.url, role: 'Desarrollador full-stack', text: 'Desarrollo de aplicaciones web con JavaScript, HTML y CSS.', tags: ['JavaScript'] },
];
// timeline lanes: months since Jan 2018 over a 108-month axis (2018 to 2026)
const lanes = [
	{ name: 'CUC', when: 'Jun 26 — hoy', l: 101, w: 5 },
	{ name: 'El Sol', when: 'Ene 26 — hoy', l: 96, w: 10 },
	{ name: 'Rocket Code', when: 'Oct 23 — Jul 26', l: 69, w: 33 },
	{ name: 'Wawandco', when: 'Ago 20 — Abr 23', l: 31, w: 32 },
	{ name: 'Koombea', when: 'Ago — Dic 18', l: 7, w: 5 },
];
const pct = (m: number) => `${((m / 108) * 100).toFixed(1)}%`;
---

<div data-kd data-t="dark">
<div class="kd-fog" aria-hidden="true"></div>
<canvas data-k="net" class="kd-net" aria-hidden="true"></canvas>

<header class="kd-top" data-k="bar">
	<a class="kd-mark" href="#top">Kevin Díaz</a>
	<nav class="kd-route" aria-label="Secciones">
		<a href="#top" data-nav="inicio"><i></i><span>Inicio</span></a>
		<a href="#sobre" data-nav="sobre"><i></i><span>Sobre mí</span></a>
		<a href="#proyectos" data-nav="proyectos"><i></i><span>Proyectos</span></a>
		<a href="#experiencia" data-nav="experiencia"><i></i><span>Experiencia</span></a>
		<a href="#contacto" data-nav="contacto"><i></i><span>Contacto</span></a>
	</nav>
	<span data-k="trace" class="kd-trace" aria-live="polite"></span>
</header>

<main id="top">
<section class="kd-hero" aria-label="Inicio">
	<div class="kd-hero-text">
		<i class="kd-anchor" data-node="inicio" aria-hidden="true"></i>
		<p class="kd-kicker"><i aria-hidden="true"></i>Desarrollador full-stack · Barranquilla</p>
		<h1>Kevin<br>Díaz</h1>
		<p class="kd-claim">Software que el equipo puede mantener. Hoy, con agentes de IA.</p>
		<div class="kd-actions">
			<span class="kd-btnw"><a class="kd-btn" href="#contacto">Escríbeme</a></span>
			<a class="kd-btn-ghost" href="/CV_KEVIN_ES.pdf" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>Ver CV</a>
		</div>
		<div class="kd-avail"><i></i>Disponible para nuevos proyectos</div>
	</div>
	<div class="kd-pw kd-portrait-w" data-tilt>
		<div class="kd-plate kd-portrait">
			<canvas data-k="cv" role="img" aria-label="Retrato de Kevin Díaz hecho de puntos que se apartan del cursor"></canvas>
			<div class="hud" aria-hidden="true">
				<span class="tl">rev {sha}<br>deploy {built}</span>
				<span class="tr" data-k="vp"></span>
				<span class="bl"><i></i>kevin.local</span>
				<span class="br"><b data-time>--:--</b> UTC−5</span>
			</div>
		</div>
	</div>
</section>

<div class="kd-band" aria-label="Tecnologías">
	<ul>{[...tech, ...tech].map((x, i) => <li style={`--d:${(i * 0.37) % 2.4}s`}><span class="mark"><img src={`/svg/tech/${x.icon}.svg`} alt="" width="36" height="36" /></span><span class="txt"><b>{x.name}</b><small>{x.kind}</small></span><span class="meta"><i aria-hidden="true"></i><em aria-hidden="true">{x.id}</em></span></li>)}</ul>
</div>

<section id="sobre" class="kd-sec">
	<div class="kd-head"><i class="kd-anchor" data-node="sobre-mi" aria-hidden="true"></i><h2>Sobre mí</h2></div>
	<div class="kd-about">
		<div class="kd-pw" data-reveal>
			<div class="kd-plate">
				<p class="kd-now"><i></i><span><b>Ahora</b> migrando módulos legacy a React y Python serverless en la Universidad de la Costa</span><small>nov 2026</small></p>
				<p class="kd-statement">Seis años construyendo productos digitales. <b>Hoy decido el rumbo y los agentes ejecutan.</b></p>
				<div class="kd-copy" data-k="bio" data-bio="corta">
					<div class="kd-bio-switch" role="group" aria-label="Longitud de la presentación">
						<button type="button" data-bio-set="corta" aria-pressed="true">corta</button>
						<button type="button" data-bio-set="larga" aria-pressed="false">larga</button>
					</div>
					<p class="short">Especificación clara, tareas pequeñas y criterios comprobables. Yo reviso y defiendo el resultado.</p>
					<div class="long">
						<p>Casi nada lo resuelvo solo. Trabajo con agentes de IA como con un equipo: cada uno recibe una tarea pequeña, un alcance claro y un criterio para saber cuándo terminó.</p>
						<p>Todo empieza por entender el problema y escribir qué se espera, con criterios que se puedan comprobar. Esa especificación es la fuente de verdad: los agentes la leen y yo la defiendo.</p>
					</div>
				</div>
				<div class="kd-facts">
					<div class="row"><span class="k">Ahora con</span><div class="v">
						{[companies.cuc, companies.elsol].map((c) => <a href={c.url} target="_blank" rel="noopener"><i>{c.short}</i>{c.name}</a>)}
					</div></div>
					<div class="row"><span class="k">Antes en</span><div class="v">
						{[companies.rocket, companies.wawandco, companies.koombea].map((c) => <a href={c.url} target="_blank" rel="noopener"><i>{c.short}</i>{c.name}</a>)}
					</div></div>
					<div class="row"><span class="k">Stack</span><div class="v">
						{tech.filter((t) => !['llm', 'hexagonal'].includes(t.icon)).map((t) => <span><i><img src={`/svg/tech/${t.icon}.svg`} alt="" width="16" height="16" /></i>{t.name}</span>)}
					</div></div>
				</div>
				<div class="kd-readouts">
					<div><b>2018</b><span>Primer empleo como desarrollador</span></div>
					<div><b>5</b><span>Empresas y clientes, del backend al frontend</span></div>
					<div><b>Yo + IA</b><span>Personas deciden, agentes ejecutan</span></div>
				</div>
			</div>
		</div>
		<div class="kd-orbit" role="img" aria-label="Cómo trabajo: yo al centro decido y reviso; los agentes entienden, delegan, verifican y entregan">
			<svg viewBox="0 0 460 460" aria-hidden="true">
				<circle class="o" cx="230" cy="230" r="200"/>
				<circle class="i" cx="230" cy="230" r="120"/>
				<circle class="me" cx="230" cy="230" r="64"/>
				<text class="me-t" x="230" y="241">yo</text>
				<rect class="st" x="224" y="24" width="12" height="12" transform="rotate(45 230 30)"/><rect class="st" x="424" y="224" width="12" height="12" transform="rotate(45 430 230)"/><rect class="st" x="224" y="424" width="12" height="12" transform="rotate(45 230 430)"/><rect class="st" x="24" y="224" width="12" height="12" transform="rotate(45 30 230)"/>
				<text class="lb" x="230" y="6">entender</text>
				<text class="lb" x="436" y="262">delegar</text>
				<text class="lb" x="230" y="466">verificar</text>
				<text class="lb" x="24" y="262">entregar</text>
				<text class="cap" x="230" y="146">agentes</text>
			</svg>
		</div>
	</div>
</section>

<section id="proyectos" class="kd-sec">
	<div class="kd-head"><i class="kd-anchor" data-node="proyectos" aria-hidden="true"></i><h2>Proyectos</h2><small>construyendo</small></div>
	<div class="kd-pw kd-building" data-reveal>
		<div class="kd-plate">
			<p class="kd-building-lede">Lo que tengo abierto ahora, con su código a la vista. El primer caso de estudio con contexto, decisiones y resultados está en camino.</p>
			<ul>
				{building.map((b) => <li><a href={b.url} target="_blank" rel="noopener"><span class="txt"><b>{b.name}</b><p>{b.text}</p><small>{b.meta}</small></span><i class="ext"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></i></a></li>)}
				<li class="pending"><div><span class="txt"><b>Primer caso de estudio</b><p>Un proyecto publicado con su contexto, decisiones y resultados. Aparecerá aquí, conectado a esta ruta.</p><small>en construcción</small></span><i class="wait" aria-hidden="true"></i></div></li>
			</ul>
		</div>
	</div>
</section>

<section id="experiencia" class="kd-sec">
	<div class="kd-head"><i class="kd-anchor" data-node="experiencia" aria-hidden="true"></i><h2>Experiencia</h2><small>2018 — hoy</small></div>
	<div class="kd-exp">
		<aside class="kd-path">
			<p>Del JavaScript de 2018 al Next.js, React Native y las integraciones con IA de hoy, pasando por Go, NestJS y AWS. Siempre en equipos que entregan.</p>
			<div class="kd-tl" aria-hidden="true">
				<div class="years">{[0, 24, 48, 72, 96].map((m, i) => <i style={`--x:${pct(m)}`}><span>'{18 + i * 2}</span></i>)}</div>
				{lanes.map((x) => <div class="row" data-end={x.l + x.w >= 88 ? '' : undefined} data-now={x.when.endsWith('hoy') ? '' : undefined} style={`--l:${pct(x.l)};--w:${pct(x.w)}`}><span class="who"><b>{x.name}</b><small>{x.when}</small></span><i class="bar"></i></div>)}
				<i class="now"><span>hoy</span></i>
			</div>
		</aside>
		<div>
			<div class="kd-jobs">
				{jobs.map((j) => (
					<div class="kd-pw" data-reveal>
						<article class="kd-plate kd-job">
							<div class="when"><span>{j.when}</span><span>{j.span}</span></div>
							<h3><a href={j.url} target="_blank" rel="noopener">{j.name}<i class="ext"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></i></a></h3>
							<div class="role">{j.role}</div>
							<div class="desc" data-k="clamp"><p>{j.text}</p><button type="button" class="more" data-more aria-expanded="false">ver más</button></div>
							<div class="kd-tags">{j.tags.map((t) => <span>{t}</span>)}</div>
						</article>
					</div>
				))}
			</div>
			<div class="kd-extra">
				<div><h3>Formación</h3><ul class="kd-list">
					<li><b>Técnico en Programación de Software<small>SENA</small></b><i></i><span>2017 — 2018</span></li>
					<li><b>Técnico en Mantenimiento de Sistemas Informáticos<small>UniBarranquilla</small></b><i></i><span>2019 — 2021</span></li>
					<li><b>Tecnólogo en Gestión de Sistemas Informáticos<small>UniBarranquilla</small></b><i></i><span>2022 — hoy</span></li>
					<li><b>Scrum Developer<small>Kleer</small></b><i></i><span>2023</span></li>
				</ul></div>
				<div><h3>Idiomas</h3><ul class="kd-list">
					<li><b>Español</b><i></i><span>Nativo</span></li>
					<li><b>Inglés</b><i></i><span>Básico</span></li>
				</ul></div>
			</div>
		</div>
	</div>
</section>

<div class="kd-paper">
<div class="kd-waves" aria-hidden="true">
	<i class="kd-anchor" data-node="contacto"></i>
	<svg viewBox="0 0 2880 140" preserveAspectRatio="none"><path class="w1" d="M0 90C240 150 480 20 720 70S1200 150 1440 90L1440 90C1680 150 1920 20 2160 70S2640 150 2880 90V140H0Z"/><path class="w2" d="M0 110C260 40 520 160 780 90S1240 30 1440 110L1440 110C1700 40 1960 160 2220 90S2680 30 2880 110V140H0Z"/><path class="w3" d="M0 120C300 80 600 130 900 100S1300 70 1440 120L1440 120C1740 80 2040 130 2340 100S2740 70 2880 120V140H0Z"/></svg>
</div>
<section id="contacto" class="kd-sec">
	<div class="kd-head"><i class="kd-anchor" aria-hidden="true"></i><h2>Contacto</h2><small>te respondo</small></div>
	<div class="kd-contact">
		<div>
			<h2>¿Tienes una idea?<b>Hablemos.</b></h2>
			<p class="kd-contact-lede">Cuéntame qué quieres construir, en qué punto está y para cuándo lo necesitas. Te respondo con una propuesta clara.</p>
			<button type="button" class="kd-mail" data-copy aria-label="Copiar correo kevindiazm.14@gmail.com">
				<i class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg></i>
				<span><b>kevindiazm.14@gmail.com</b><small data-k="mail-hint">clic para copiar el correo</small></span>
				<i class="act"><svg class="cp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.5"/><path d="M5 15V5a1 1 0 0 1 1-1h10"/></svg><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></i>
			</button>
			<div class="kd-contact-meta"><span><i></i>Freelance y contratos</span><span><i></i>Remoto desde Barranquilla</span></div>
		</div>
		<div class="kd-cols">
			<div><h3>Canales</h3><ul class="kd-tiles">
				<li><a href="https://github.com/KevinDM15" target="_blank" rel="noopener"><i class="ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg></i><span><b>GitHub</b><small>/KevinDM15</small></span></a></li>
				<li><a href="https://www.linkedin.com/in/kevindm14/" target="_blank" rel="noopener"><i class="ic"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></i><span><b>LinkedIn</b><small>/in/kevindm14</small></span></a></li>
				<li><a href="tel:+573002329174"><i class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg></i><span><b>Teléfono</b><small>+57 300 232 9174</small></span></a></li>
			</ul></div>
			<div><h3>Desde Barranquilla</h3>
				<div class="kd-clock">
					<svg viewBox="0 0 100 100" aria-hidden="true">
						<circle cx="50" cy="50" r="49" fill="none" stroke-width="1" opacity=".5"/>
						<path d="M50 4V14M96 50H86M50 96V86M4 50H14" fill="none" stroke-width="2"/>
						<line data-k="hh" x1="50" y1="50" x2="50" y2="27" stroke-width="3.4" stroke-linecap="round"/>
						<line data-k="mm" x1="50" y1="50" x2="50" y2="13" stroke-width="2" stroke-linecap="round"/>
						<g data-k="sec"><line x1="50" y1="60" x2="50" y2="9" stroke-width="1.2"/><rect x="47.4" y="6.4" width="5.2" height="5.2" transform="rotate(45 50 9)"/></g>
						<rect x="47" y="47" width="6" height="6" transform="rotate(45 50 50)"/>
					</svg>
					<div><b data-time>--:--</b><p>Hora de Colombia · UTC−5</p></div>
				</div>
			</div>
		</div>
	</div>
</section>

<footer class="kd-foot">
	<div>
