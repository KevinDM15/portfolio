---
import './portfolio.css';
import { ChatBot } from '../islands/ChatBot';
---

<div data-kd style="--bg:#EFEEE9; --surface:#E4E3DC; --fg:#0F0F11; --muted:#5D5D66; --line:rgba(15,15,17,.12); --line-strong:rgba(15,15,17,.32); --accent:#2A3BFF; --grain:.12; position:relative; background:var(--bg); color:var(--fg); font:400 16px/1.6 'DM Mono',ui-monospace,Menlo,monospace; letter-spacing:-.01em; -webkit-font-smoothing:antialiased">
<div data-k="wrap" style="container-type:inline-size; position:relative; overflow-x:clip; --g:clamp(16px,4cqw,56px)">

<div data-k="cols" aria-hidden="true" style="position:absolute; inset:0; pointer-events:none; z-index:0">

</div>
<div aria-hidden="true" style="position:absolute; inset:0; pointer-events:none; z-index:60; opacity:var(--grain); mix-blend-mode:overlay; background-image:url(svg/textura-grano.svg)"></div>

<header style="position:sticky; top:0; z-index:50; height:0; padding:0 var(--g); pointer-events:none">
<div data-glow style="pointer-events:auto; position:relative; isolation:isolate; box-sizing:border-box; margin:10px auto 0; width:var(--L-glassW); height:var(--L-glassH); display:flex; align-items:center; justify-content:space-between; gap:12px; padding:0 9px 0 20px; border-radius:999px; background:linear-gradient(115deg, color-mix(in srgb, var(--fg) 13%, transparent), color-mix(in srgb, var(--fg) 3%, transparent) 42%, color-mix(in srgb, var(--fg) 9%, transparent)); -webkit-backdrop-filter:blur(16px) saturate(1.9); backdrop-filter:blur(16px) saturate(1.9); border:1px solid color-mix(in srgb, var(--fg) 16%, transparent); box-shadow:inset 0 1.5px 0 rgba(255,255,255,.38), inset 0 -1.5px 0 rgba(255,255,255,.07), inset 7px 0 14px -9px color-mix(in srgb, var(--accent) 45%, transparent), inset -7px 0 14px -9px rgba(90,130,255,.45), 0 14px 36px -10px rgba(0,0,0,.5), 0 2px 6px rgba(0,0,0,.16); transition:width .6s cubic-bezier(.7,0,.2,1), height .6s cubic-bezier(.7,0,.2,1)">
<span aria-hidden="true" style="position:absolute; inset:0; border-radius:inherit; z-index:-1; pointer-events:none; background:radial-gradient(200px 100px at var(--mx,28%) var(--my,0%), rgba(255,255,255,.3), transparent 70%); mix-blend-mode:overlay"></span>
<a href="#top" aria-label="Inicio" style="display:inline-flex; align-items:center; gap:10px; text-decoration:none; color:var(--fg); font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; font-size:21px; letter-spacing:.02em; text-transform:uppercase; white-space:nowrap"><b style="width:10px; height:10px; border-radius:50%; background:var(--accent); display:block; box-shadow:0 0 12px var(--accent)"></b>Kevin Díaz</a>
<nav data-if="nav" aria-label="Secciones" style="display:flex; gap:2px; font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase">
    <a href="#proyectos" data-nav="proyectos" style="text-decoration:none; padding:10px 17px; border-radius:999px; transition:color .3s, background .3s; " class="hv0">Proyectos</a>
    <a href="#experiencia" data-nav="experiencia" style="text-decoration:none; padding:10px 17px; border-radius:999px; transition:color .3s, background .3s; " class="hv0">Experiencia</a>
    <a href="#contacto" data-nav="contacto" style="text-decoration:none; padding:10px 17px; border-radius:999px; transition:color .3s, background .3s; " class="hv0">Contacto</a>
  </nav>

<div style="display:flex; align-items:center; gap:12px">
  <span data-if="clock" style="font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); font-variant-numeric:tabular-nums">BAQ <span data-time>--:--</span></span>
  <button data-k="theme" type="button" aria-label="Cambiar tema" style="width:40px; height:40px; border-radius:50%; display:grid; place-items:center; color:var(--fg); border:1px solid color-mix(in srgb, var(--fg) 18%, transparent); background:color-mix(in srgb, var(--fg) 8%, transparent); box-shadow:inset 0 1px 0 rgba(255,255,255,.32); transition:background .3s, transform .4s cubic-bezier(.34,1.5,.5,1)" class="hv1">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" style="width:16px; height:16px"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>
  </button>
</div>
</div>
</header>

<main id="top" style="position:relative; z-index:1">

<section data-screen-label="01 Hero" style="position:relative; box-sizing:border-box; max-width:1480px; margin:0 auto; padding:calc(80px + clamp(28px,6cqw,72px)) var(--g) 28px; min-height:var(--L-heroMin); display:flex; flex-direction:column; justify-content:space-between; gap:32px">
<div data-k="orb" style="position:var(--L-orbPos); right:var(--L-orbRight); z-index:0; aspect-ratio:1; width:var(--L-orbW); top:var(--L-orbTop); bottom:var(--L-orbBottom); margin:var(--L-orbMargin); order:1">
  <canvas data-k="cv" role="img" aria-label="Retrato de Kevin hecho de puntos que se apartan del cursor" style="width:100%; height:100%; display:block"></canvas>
  
    <div data-note="1" aria-hidden="true" style="position:absolute; z-index:3; left:var(--L-pn-l); right:var(--L-pn-r); top:var(--L-pn-t); bottom:var(--L-pn-b); display:flex; flex-direction:column; gap:2px; font-family:'Reenie Beanie',cursive; color:var(--accent); font-size:clamp(24px,2.8cqw,38px); line-height:.9; transform:rotate(-5deg); pointer-events:none">
      <svg viewBox="0 0 110 70" style="width:clamp(56px,8cqw,104px); overflow:visible; fill:none; stroke:var(--accent); stroke-width:3; stroke-linecap:round; stroke-linejoin:round"><path data-ink="1" pathLength="1" d="M8 64C20 30 56 10 98 8M84 -2L99 8L86 22" style="stroke-dasharray:1"></path></svg>
      <span data-t="1">este soy yo,<br>sin filtro</span>
    </div>
  
</div>

<div style="position:relative; z-index:1; display:flex; justify-content:space-between; gap:8px 16px; flex-wrap:wrap; font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted)">
  <span>Edición 2026</span><span>10.96° N / 74.80° W</span><span>Barranquilla, Colombia</span>
</div>

<div style="position:relative; order:2; margin-top:clamp(72px,6cqw,88px)">
  
    <div data-note="1" aria-hidden="true" style="position:absolute; z-index:3; left:clamp(0px,1cqw,16px); top:0; transform:translateY(-108%) rotate(-3deg); display:flex; flex-direction:column; font-family:'Reenie Beanie',cursive; color:var(--accent); font-size:clamp(24px,2.8cqw,38px); line-height:.9; pointer-events:none">
      <span data-t="1">¿qué más? un gusto.</span>
      <svg viewBox="0 0 124 14" style="width:120px; margin-top:2px; overflow:visible; fill:none; stroke:var(--accent); stroke-width:3; stroke-linecap:round"><path data-ink="1" pathLength="1" d="M2 8Q20 0 40 8T80 8T120 6" style="stroke-dasharray:1"></path></svg>
    </div>
  
  <h1 aria-label="Kevin Díaz" style="position:relative; z-index:1; margin:0; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; line-height:.8; letter-spacing:-.025em; font-size:clamp(88px,21cqw,340px)">
    <span style="display:block; overflow:hidden; padding:.06em 0 .02em"><span data-ln="1" style="display:block">Kevin</span></span>
    <span style="display:block; overflow:hidden; padding:.06em 0 .02em clamp(24px,9cqw,170px)"><span data-ln="1" style="display:block">Díaz<em style="font-family:'Instrument Serif',Georgia,serif; font-weight:400; text-transform:none; letter-spacing:-.04em; color:var(--accent)">.</em></span></span>
  </h1>
  <div style="position:relative; z-index:1; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:flex-end; gap:24px; margin-top:clamp(24px,4cqw,48px)">
    <p style="margin:0; flex:1 1 300px; max-width:40ch; font-size:clamp(15px,1.6cqw,18px); color:var(--fg); text-wrap:pretty">Desarrollador de software <span style="font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:1.2em; color:var(--accent)">full-stack</span>. Construyo APIs con arquitectura limpia y interfaces que el equipo puede mantener.</p>
    <a href="#contacto" data-glow style="position:relative; isolation:isolate; box-sizing:border-box; display:inline-flex; align-items:center; justify-content:space-between; gap:22px; padding:10px 10px 10px 24px; border-radius:999px; text-decoration:none; color:var(--fg); overflow:hidden; flex:var(--L-availFlex); background:linear-gradient(115deg, color-mix(in srgb, var(--fg) 12%, transparent), color-mix(in srgb, var(--fg) 3%, transparent) 45%, color-mix(in srgb, var(--fg) 8%, transparent)); -webkit-backdrop-filter:blur(14px) saturate(1.8); backdrop-filter:blur(14px) saturate(1.8); border:1px solid color-mix(in srgb, var(--fg) 16%, transparent); box-shadow:inset 0 1.5px 0 rgba(255,255,255,.34), inset 0 -1.5px 0 rgba(255,255,255,.06), 0 14px 32px -12px rgba(0,0,0,.5); transition:transform .5s cubic-bezier(.34,1.5,.5,1), border-color .3s" class="hv2">
      <span aria-hidden="true" style="position:absolute; inset:0; border-radius:inherit; z-index:-1; pointer-events:none; background:radial-gradient(160px 90px at var(--mx,20%) var(--my,0%), rgba(255,255,255,.28), transparent 70%); mix-blend-mode:overlay"></span>
      <span style="display:flex; flex-direction:column; gap:4px">
        <small style="font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted)">Estado · <b style="color:var(--fg); font-weight:500; font-variant-numeric:tabular-nums"><span data-time>--:--</span></b> en Barranquilla</small>
        <strong style="font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(21px,2.1cqw,28px); line-height:.95">Disponible para <em style="font-family:'Instrument Serif',Georgia,serif; font-weight:400; text-transform:none; color:var(--accent); letter-spacing:-.02em; font-size:1.15em">nuevos proyectos</em></strong>
      </span>
      <span aria-hidden="true" style="width:46px; height:46px; border-radius:50%; display:grid; place-items:center; flex:none; background:var(--accent); color:#fff; box-shadow:inset 0 1px 0 rgba(255,255,255,.4), 0 8px 18px -6px var(--accent)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px; height:18px; transform:rotate(-45deg)"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
    </a>
  </div>
</div>
</section>

<div aria-label="Tecnologías" data-marq-host style="position:relative; z-index:1; overflow:hidden; padding:14px 0; border-top:1px solid var(--line-strong); border-bottom:1px solid var(--line-strong); background:var(--bg)">
<div data-k="marq" style="display:flex; width:max-content; will-change:transform">
  <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Next.js<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">React<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">TypeScript<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">NestJS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Go<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">PostgreSQL<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">AWS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">TailwindCSS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Redux<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Vue.js<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Ruby on Rails<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Next.js<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">React<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">TypeScript<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">NestJS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Go<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">PostgreSQL<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">AWS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">TailwindCSS<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Redux<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:var(--fg); -webkit-text-stroke:0px transparent">Vue.js<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
    <span style="display:inline-flex; align-items:center; gap:36px; padding-right:36px; white-space:nowrap; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:800; text-transform:uppercase; font-size:clamp(28px,4.4cqw,56px); line-height:1; color:transparent; -webkit-text-stroke:1px var(--fg)">Ruby on Rails<i style="width:10px; height:10px; background:var(--accent); transform:rotate(45deg); -webkit-text-stroke:0"></i></span>
</div>
</div>

<section id="sobre" data-screen-label="02 Sobre mí" style="box-sizing:border-box; max-width:1480px; margin:0 auto; padding:clamp(96px,16cqw,220px) var(--g)">
<div style="display:grid; gap:12px clamp(24px,4cqw,64px); align-items:start; grid-template-columns:var(--L-leadCols)">
  <span style="font-family:'DM Mono',monospace; font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); padding-top:.6em">( Sobre mí )</span>
  <p data-k="st" style="--p:100%; margin:0; max-width:20ch; font-family:'Barlow Condensed','Arial Narrow',sans-serif; font-weight:600; text-transform:uppercase; font-size:clamp(34px,5.4cqw,88px); line-height:.98; letter-spacing:-.015em; color:transparent; background-image:linear-gradient(180deg, var(--fg) var(--p), color-mix(in srgb, var(--fg) 16%, transparent) calc(var(--p) + 6%)); -webkit-background-clip:text; background-clip:text">Llevo más de seis años construyendo productos digitales. Diseño <em style="font-family:'Instrument Serif',Georgia,serif; font-weight:400; text-transform:none; letter-spacing:-.03em">APIs</em> con arquitectura hexagonal, interfaces con componentes reutilizables y código que escala sin dolor.</p>
