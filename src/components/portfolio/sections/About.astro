---
/* sobre mí: the statement, one line of method, the fact rows, three readouts, and the orbit beside them */
import Orbit from './Orbit.astro';
import { now, before, stack, readouts } from '../data';
---

<section id="sobre" class="kd-sec">
	<div class="kd-head"><i class="kd-anchor" data-node="sobre-mi" aria-hidden="true"></i><h2>Sobre mí</h2></div>
	<div class="kd-about">
		<div class="kd-pw" data-reveal>
			<div class="kd-plate">
				<p class="kd-statement">Seis años construyendo productos digitales. <b>Hoy decido el rumbo y los agentes ejecutan.</b></p>
				<div class="kd-copy">
					<p>Especificación clara, tareas pequeñas y criterios comprobables. Yo reviso y defiendo el resultado.</p>
				</div>
				<div class="kd-facts">
					<div class="row"><span class="k">Ahora con</span><div class="v">
						{now.map((c) => <a href={c.url} target="_blank" rel="noopener"><i>{c.short}</i>{c.name}</a>)}
					</div></div>
					<div class="row"><span class="k">Antes en</span><div class="v">
						{before.map((c) => <a href={c.url} target="_blank" rel="noopener"><i>{c.short}</i>{c.name}</a>)}
					</div></div>
					<div class="row"><span class="k">Stack</span><div class="v">
						{stack.map((t) => <span><i><img src={`/svg/tech/${t.icon}.svg`} alt="" width="16" height="16" /></i>{t.name}</span>)}
					</div></div>
				</div>
				<div class="kd-readouts">
					{readouts.map((r) => <div><b>{r.figure}</b><span>{r.text}</span></div>)}
				</div>
			</div>
		</div>
		<Orbit />
	</div>
</section>
