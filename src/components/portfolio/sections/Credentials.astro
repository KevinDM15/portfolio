---
/* formación and idiomas in one plate: credentials as icon rows, languages with a five-step meter */
import GraduationCap from '../../icons/GraduationCap.astro';
import Award from '../../icons/Award.astro';
import { credentials, languages } from '../data';
const STEPS = [1, 2, 3, 4, 5];
---

<div class="kd-pw kd-extra-w" data-reveal>
	<div class="kd-plate kd-extra">
		<div>
			<h3>Formación</h3>
			<ul class="kd-creds">
				{credentials.map((c) => (
					<li>
						<i class="ic">{c.kind === 'degree' ? <GraduationCap /> : <Award />}</i>
						<span><b>{c.title}</b><small>{c.detail}</small></span>
					</li>
				))}
			</ul>
		</div>
		<div>
			<h3>Idiomas</h3>
			<ul class="kd-langs">
				{languages.map((l) => (
					<li>
						<span><b>{l.name}</b><small>{l.detail}</small></span>
						<i class="lvl" aria-hidden="true">{STEPS.map((n) => <b data-on={n <= l.level ? '' : undefined}></b>)}</i>
					</li>
				))}
			</ul>
		</div>
	</div>
</div>
